rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'zionomari@artsaturated.com';
    }

    // ── Product images — admin uploads, public reads ──────────────────────────
    match /products/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Event flyers — authenticated users can upload; public reads ───────────
    match /event-flyers/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Event recap photos — open submissions; public reads ───────────────────
    match /event-recaps/{allPaths=**} {
      allow read:  if true;
      allow write: if true;
    }

    // ── CD order / quote uploads — open uploads; admin reads only ─────────────
    match /quotes/{allPaths=**} {
      allow read:  if isAdmin();
      allow write: if true;
    }

    // ── Art submission images — authenticated per-user paths ──────────────────
    match /submissions/{userId}/{allPaths=**} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Commission request attachments — authenticated; admin reads ───────────
    match /commissions/{allPaths=**} {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Blog submission cover images — authenticated; public reads ────────────
    match /blog-covers/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── User profile avatars — public reads; owner writes ─────────────────────
    match /avatars/{userId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Creator profile banners — public reads; owner writes ──────────────────
    match /banners/{userId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /banners/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
