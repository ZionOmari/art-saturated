rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'zionomari@artsaturated.com';
    }

    // ── Product images — admin uploads, public reads ──────────────────────────
    match /products/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── CD printing uploads — customer writes under their own uid; admin reads ─
    // (Legacy uploads sit directly under quotes/<timestamp>/ and are read-only.)
    match /quotes/{allPaths=**} {
      allow read:  if isAdmin();
    }
    match /quotes/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 300 * 1024 * 1024;
    }

    // ── User profile avatars — public reads; owner writes ─────────────────────
    match /avatars/{userId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Creator profile banners — public reads; owner writes ──────────────────
    match /banners/{userId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /banners/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Paid digital releases — NEVER publicly readable ───────────────────────
    // Buyers never read this path directly. The generateDownloadLink function
    // verifies the purchase and hands back a short-lived signed URL. Preview
    // clips are a different thing entirely and live under products/audio/.
    match /releases/{allPaths=**} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
